# 쓰는 것만 채우면 됩니다. 빈 칸인 제공사는 보드에서 자동으로 비활성화됩니다.
# 키는 서버에서만 쓰이고 브라우저로 내려가지 않습니다.

# https://platform.claude.com  (Console > API Keys)
ANTHROPIC_API_KEY=

# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OpenAI 호환 서버로 돌릴 때만 설정 (OpenRouter, 로컬 모델 등). 비우면 OpenAI 공식.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 원화 환산에 쓰는 환율. 비워두면 1450원으로 계산합니다.
USD_KRW=1450
